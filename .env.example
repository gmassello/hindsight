# DataHub connection
DATAHUB_GMS_URL=http://localhost:8080
# Personal access token; leave empty when METADATA_SERVICE_AUTH is disabled (local quickstart)
DATAHUB_GMS_TOKEN=
# Optional: streamable-HTTP MCP endpoint (DataHub Cloud). Empty = spawn local stdio server
DATAHUB_MCP_URL=
DATAHUB_MCP_COMMAND=uvx mcp-server-datahub

# LLM provider: gemini | anthropic | bedrock
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
MAX_TOKENS=4096

# Agent behavior
# Human gate: keep false. The agent can run autonomously, but asking permission is the default.
HINDSIGHT_AUTO_APPROVE=false
HINDSIGHT_MAX_HOPS=3
PHASE_MAX_TURNS=12
AUDIT_LOG_PATH=var/audit-log.jsonl

CORS_ORIGINS=http://localhost:5173
